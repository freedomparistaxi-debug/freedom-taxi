# ============================================
#  Freedom Taxi — variables d'environnement
# ============================================
#  Copiez ce fichier en ".env" et complétez-le.
#
#  ⚠️  NE JAMAIS versionner le fichier .env : il contient le mot de passe
#      SMTP. Seul ce fichier d'exemple (.env.example) est versionné, et il
#      ne contient AUCUNE valeur réelle.
#
#  Toutes les variables ci-dessous sont LUES CÔTÉ SERVEUR uniquement.
#  Rien de ce fichier n'est envoyé au navigateur : le front ne reçoit
#  que des variables préfixées par VITE_, et il n'y en a aucune ici.
# ============================================

# --- Serveur SMTP (pour l'envoi des demandes de réservation) ---
#    Freedom Taxi EXPÉDIE depuis ce compte Gmail ; les réservations sont
#    RECUES dans la boîte Yahoo indiquée plus bas (BOOKING_TO).
#    Si vous changez de fournisseur (Yahoo, OVH, SendGrid, Brevo...), changez
#    uniquement SMTP_HOST / SMTP_PORT, le reste ne bouge pas.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
#    true uniquement si le serveur attend une connexion TLS directe
#    (en général uniquement sur le port 465).
SMTP_SECURE=false

# --- Identifiants SMTP ---
#    Adresse du compte qui ENVOIE les demandes.
SMTP_USER=freedom.paris.taxi@gmail.com
#    Mot de passe d'application. JAMAIS le mot de passe du compte lui-même.
#    Google : Compte > Sécurité > Validation en 2 étapes > Mots de passe
#    d'application. Gmail refuse le mot de passe normal du compte.
SMTP_PASS=

# --- Destinataire des demandes de réservation ---
#    Adresse qui reçoit les demandes envoyées depuis le site.
#    ⚠️  C'est CETTE variable qu'il faut renseigner chez l'hébergeur
#        (dashboard Vercel > Settings > Environment Variables, ou le .env
#        du serveur). Elle est prioritaire sur la valeur de repli du code.
BOOKING_TO=Dominique_tanoh94@yahoo.fr
# --- Adresse d'expéditeur affichée dans le mail ---
BOOKING_FROM=Freedom Taxi <freedom.paris.taxi@gmail.com>

# --- Port du serveur de production (npm start) ---
#    5175 en développement. En production, laissez le choix à l'hébergeur.
PORT=5175

# --- Nombre de proxys devant l'application ---
#    1 = un reverse proxy devant le serveur (Nginx, Caddy, la plupart des
#    hébergeurs). Laissez tel quel sauf architecture particulière.
TRUST_PROXY=1

# ============================================
#  Supabase — NON UTILISÉ POUR LE MOMENT
# ============================================
#  Le projet n'utilise pas encore Supabase. Ces variables sont laissées VIDES
#  et NE DOIVENT PAS être remplies tant que l'intégration n'est pas décidée.
#
#  ⚠️  Seul le nom public (« publishable », anciennement « anon ») a le droit
#      d'arriver dans le code du navigateur. La clé secrète « secret », ou
#      l'ancienne « service_role », NE DOIVENT JAMAIS être écrites dans une
#      variable lue par Vite : elle finirait dans le bundle JS, donc visible
#      par tout le monde. Elles ne servent qu'à un script exécuté côté serveur.
#
#  Rappel : Vite ne lit que les variables préfixées par VITE_ et les inscrit
#  dans le bundle. Toute variable VITE_ est donc PUBLIQUE.
# ============================================
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

